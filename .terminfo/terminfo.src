rxvt-unicode-256color|rxvt-unicode terminal with 256 colors (X Window System) + xterm+sm+1006,
	XT,
	colors#256, pairs#32767,
	Se=\E[2 q, Ss=\E[%p1%d q,
	Cr=\E]12;15\007, Cs=\E]12;%p1%s\007,
	Ms=\E]52;%p1%s;%p2%s\007,
	kf13=\E[11$, kf14=\E[12$, kf15=\E[13$, kf16=\E[14$, kf17=\E[15$, kf18=\E[17$,
	kf19=\E[18$, kf20=\E[19$, kf21=\E[20$, kf22=\E[21$, kf23=\E[23$, kf24=\E[24$,
	kf25=\E[5\^, kf26=\E[6\^,
	use=xterm+sm+1006,
	use=xterm+focus,
	use=bracketed+paste,
	use=rxvt-unicode,

tmux-256color|tmux with 256 colors + xterm+sm+1006,
	use=xterm+sm+1006,
	use=xterm+256setaf, use=tmux,

