#!/usr/bin/env bash
# shellcheck external-sources=false

# Continually sync file changes to a GitHub Codespace
# (a wrapper for watchexec/rsync)

set -eu -o pipefail

function help {
	echo "Usage: $0 [-n|--dry-run] cs.my-space.my-branch"
}

function usage {
	cat <<-"END"
		name "git-gh-codespace-rsync"
		bin "git-gh-codespace-rsync"

		flag "-h --help" help="Print the CLI help"
		flag "-n --dry-run" help="Pass --dry-run to rsync"

		arg "<codespace>" help="hostname of the Codespace to ssh to"
		complete "codespace" run="git-gh-codespace-rsync --usage-complete-host"
END
}

function usage-complete-host {
	# shellcheck disable=SC1091
	. /usr/share/bash-completion/bash_completion
	if _comp_compgen_known_hosts -a "cs."; then
		printf "%s\n" "${COMPREPLY[@]}"
	fi
}

options=$(unset GETOPT_COMPATIBLE && getopt -o hn --long help,usage,usage-complete-host,dry-run -- "$@")
eval "set -- $options"

dry_run=
while (( $# )); do
	opt=$1; shift
	case "$opt" in
		-h|--help) help; exit ;;
		--usage) usage; exit ;;
		--usage-complete-host) usage-complete-host; exit ;;
		-n|--dry-run) dry_run=: ;;
		--) break ;;
	esac
done

if (( $# != 1 )); then
	usage
	exit 1
fi

: "${1:?}"
if [[ $1 == *:* ]]; then
	codespace=${1%%:*}
	path=${1#*:}
else
	codespace=${1}
	path=
fi

workspace=$(ssh "$codespace" -- "bash -l -c $(printf %q "cd $(printf %q "$path") && pwd")" | tail -1)
: "${workspace:?}"

rsync_flags=(
	${dry_run:+--dry-run}
	--checksum
	--itemize-changes
	--links
	--executability
	--from0
	--files-from=-
)

exec watchexec -- "git ls-files -z | rsync ${rsync_flags[*]} ./ $(printf "%q:%q/" "$1" "$workspace")"
