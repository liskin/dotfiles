#!/usr/bin/env bash

set -eu

export FONTCONFIG_FILE=~/.config/fontconfig/browser.conf

function join { local IFS="$1"; shift; echo "$*"; }

if [[ -x /usr/bin/google-chrome ]]; then
	bin=/usr/bin/google-chrome
elif [[ -x /usr/bin/chromium ]]; then
	bin=/usr/bin/chromium
	if [[ -e ~/.config/liskin-google-chrome/env ]]; then
		# shellcheck disable=1090
		. ~/.config/liskin-google-chrome/env
	fi
else
	echo no chrome >&2
	exit 1
fi

exec \
	"$bin" \
	--disable-smooth-scrolling \
	--disk-cache-size=2000000000 \
	--enable-easy-off-store-extension-install \
	--disable-font-subpixel-positioning \
	--disable-features="$(join "," \
	)" \
	--enable-features="$(join "," \
		BatterySaverModeAvailable \
		HighEfficiencyModeAvailable \
		VaapiVideoEncoder \
		VaapiVideoDecodeLinuxGL \
		AcceleratedVideoEncoder \
		AcceleratedVideoDecodeLinuxGL \
		AcceleratedVideoDecodeLinuxZeroCopyGL \
		FluentOverlayScrollbar \
		Vulkan \
		DefaultANGLEVulkan \
		VulkanFromANGLE \
	)" \
	"$@"
