#!/usr/bin/env bash
set -eu -o pipefail

nmcli-online || { sleep 30; nmcli-online; } || { echo "not online, skipping"; exit; }

unset SSH_AUTH_SOCK

cd ~/backup/nomi
rsync \
	--info=stats \
	-hazxHAXS --delete \
	--rsh="ssh -o IdentityFile=~/.ssh/$MAIL_SSH_KEY" \
	"$MAIL_SSH_HOST":Mail \
	"$MAIL_SSH_HOST":Mail-old \
	./

mu index --quiet
