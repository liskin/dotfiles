#!/usr/bin/env bash

set -eu

export DOTNET_CLI_TELEMETRY_OPTOUT=${DOTNET_CLI_TELEMETRY_OPTOUT:-1}
export DOTNET_ROOT=${DOTNET_ROOT:-~/bin/.ext/.ext-dotnet}

bin="$DOTNET_ROOT/$(basename "$0")"

if [[ ${_LISKIN_DOTNET_BWRAP-} ]]; then
	exec "$bin" "$@"
fi

_LISKIN_DOTNET_BWRAP=: \
exec bwrap-home \
	--home ~/.dotnet-home \
	-- \
	"$bin" "$@"
