#!/usr/bin/env bash

set -eu
shopt -s nullglob

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_ROOT=~/bin/.ext/.ext-dotnet

for bin in ~/.var/app/com.visualstudio.code/data/vscode/extensions/ms-dotnettools.csharp-*/.roslyn/Microsoft.CodeAnalysis.LanguageServer; do
	break
done

_LISKIN_DOTNET_BWRAP=: \
exec bwrap-home \
	--home ~/.dotnet-home \
	--tmp /tmp/.dotnet-tmp \
	--mount-rw "$(dirname "$bin")" \
	--mount-rw ~/.local/state/nvim \
	--mount-rw /tmp/nvim."$USER" \
	-- \
	"$bin" "$@"
