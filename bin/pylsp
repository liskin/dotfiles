#!/usr/bin/env bash

# workaround to make pylsp see modules in virtualenvs
#
# (mypy would need this too had it not been for its mypy.python_executable
# option in setup.cfg)
#
# See: https://github.com/python-lsp/python-lsp-server/pull/643/files

set -eu

# TODO: pipenv/poetry support - https://github.com/python-lsp/python-lsp-server/pull/68#issuecomment-894650876
# TODO: use uv instead (do we need this?) - uv run --with python-lsp-server,pylsp-mypy pylsp

if [[ -x .venv/bin/python3 ]]; then
	if .venv/bin/python3 -m pylsp --version &>/dev/null; then
		# venv has pylsp (either its own or through system-site-packages venv)
		exec .venv/bin/python3 -m pylsp "$@"
	else
		# no pylsp in venv, set VIRTUAL_ENV for jedi at least
		VIRTUAL_ENV=$(readlink -f .venv)
		export VIRTUAL_ENV
	fi
fi

exec /usr/bin/pylsp "$@"
