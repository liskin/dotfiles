help:
    @just --list --unsorted

# ----------------------------------------------------------------------

_download url:
    wcurl \
        --curl-options --skip-existing \
        --curl-options --remove-on-error \
        '{{ url }}' \
        -O '{{ file_stem(url) }}-{{ datetime('%Y-%m-%d') }}.{{ extension(url) }}'

[group('download')]
download-debian-13: (_download "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-nocloud-amd64.qcow2")

[group('download')]
download-debian-14: (_download "https://cloud.debian.org/images/cloud/forky/daily/latest/debian-14-nocloud-amd64-daily.qcow2")

[group('download')]
download-debian-sid: (_download "https://cloud.debian.org/images/cloud/sid/daily/latest/debian-sid-nocloud-amd64-daily.qcow2")

[group('download')]
download-fedora-43: (_download "https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2")

[group('download')]
download-fedora-44: (_download "https://download.fedoraproject.org/pub/fedora/linux/releases/test/44_Beta/Cloud/x86_64/images/Fedora-Cloud-Base-UEFI-UKI-44_Beta-1.2.x86_64.qcow2")

# ----------------------------------------------------------------------

default_size := '20G'
default_os := 'debianunstable'
default_mem := '8192'
default_vcpus := shell('nproc')

[group('prep')]
img-create base img size=default_size:
    [ ! -e '{{ img }}' ]
    qemu-img create -f qcow2 -F qcow2 -b '{{ base }}' '{{ img }}' '{{ size }}'

[group('prep')]
img-customize img:
    virt-customize \
        -a '{{ img }}' \
        --firstboot-install openssh-server,systemd-repart \
        --firstboot-command 'systemctl start systemd-repart.service' \
        --firstboot-command 'systemctl restart systemd-growfs-root.service' \
        --ssh-inject root:file:'{{ home_directory() }}'/.ssh/id_rsa_vagrant.pub \
        --mkdir /usr/lib/repart.d \
        --append-line '/usr/lib/repart.d/50-root.conf:[Partition]' \
        --append-line '/usr/lib/repart.d/50-root.conf:Type=root' \
        --timezone Europe/London \
        --hostname '{{ file_stem(img) }}' \
        --root-password password:

[arg('mem', long)]
[arg('os', long)]
[arg('vcpus', long)]
[group('prep')]
vm-define img os=default_os mem=default_mem vcpus=default_vcpus:
    virt-install \
        --name '{{ file_stem(img) }}' \
        --osinfo '{{ os }}' \
        --boot uefi \
        --vcpus '{{ vcpus }}' \
        --memory '{{ mem }}' \
        --import --disk '{{ img }}' \
        --network bridge=virbr0 \
        --graphics listen=none,gl.enable=yes \
        --vsock cid.auto=yes \
        --noautoconsole \
        --noreboot

[arg('size', long)]
[arg('os', long)]
[arg('mem', long)]
[arg('vcpus', long)]
[group('prep')]
vm-create name base size=default_size os=default_os mem=default_mem vcpus=default_vcpus:
    just img-create '{{ base }}' '{{ name }}.qcow2' '{{ size }}'
    just img-customize '{{ name }}.qcow2'
    just vm-define '{{ name }}.qcow2' --os '{{ os }}' --mem '{{ mem }}' --vcpus '{{ vcpus }}'

[group('prep')]
x-osinfo-list:
    virt-install --osinfo list
